# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น git)

# Connection string จาก Neon Console (Dashboard > Connection Details)
# ใช้ตัวที่มี "pooled connection" (มี -pooler ใน host) สำหรับ backend ที่รับ request พร้อมกันหลายทาง
DATABASE_URL=postgresql://neondb_owner:xxxxxxxx@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ตั้งค่าเอง เป็น string สุ่มยาวๆ (ใช้เซ็น JWT token ตอน login)
JWT_SECRET=change-this-to-a-long-random-string

# บัญชีแอดมินตั้งต้น (ใช้ตอนรัน `npm run seed` ครั้งแรกเท่านั้น)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123 

# origin ของ frontend ที่อนุญาตให้เรียก API (คั่นด้วย comma ถ้ามีหลายที่)
CORS_ORIGIN=http://localhost:5173,http://172.16.23.111:5173
PORT=3001

# Google Apps Script Web App Mailer (HTTPS พอร์ต 443 — แนะนำบน Render/Cloud ที่บล็อก SMTP)
# GAS_MAIL_URL=https://script.google.com/macros/s/xxxxxxxxxxxx/exec
# GAS_MAIL_KEY=your_secret_key_here

# หรือส่งผ่าน Brevo HTTP API
# BREVO_API_KEY=xkeysib-xxxxxxxxx

# หรือส่งผ่าน SMTP ดั้งเดิม (ไม่เหมาะกับโฮสต์ฟรีที่บล็อกพอร์ตอีเมล)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# MAIL_FROM="Intranet <your_email@gmail.com>"