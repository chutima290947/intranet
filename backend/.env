# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น git)

# Connection string จาก Neon Console (Dashboard > Connection Details)
# ใช้ตัวที่มี "pooled connection" (มี -pooler ใน host) สำหรับ backend ที่รับ request พร้อมกันหลายทาง
DATABASE_URL=postgresql://neondb_owner:npg_0WH9ULvZwBTY@ep-ancient-math-azjs5r86-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ตั้งค่าเอง เป็น string สุ่มยาวๆ (ใช้เซ็น JWT token ตอน login)
JWT_SECRET=7a3f9c1e2b4d6a8f0c1e3b5d7f9a1c3e5b7d9f1a3c5e7b9d1f3gscn25sa62v3

# บัญชีแอดมินตั้งต้น (ใช้ตอนรัน `npm run seed` ครั้งแรกเท่านั้น)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345

# origin ของ frontend ที่อนุญาตให้เรียก API (คั่นด้วย comma ถ้ามีหลายที่)
CORS_ORIGIN=http://localhost:5173

PORT=3001
